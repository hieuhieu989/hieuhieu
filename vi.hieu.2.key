-- by vi hieu
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ViHieuKeySystem"
ScreenGui.Parent = CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.Position = UDim2.new(0.5, -160, 0.5, -115)
MainFrame.Size = UDim2.new(0, 320, 0, 230)
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true

-- 
MainFrame.Size = UDim2.new(0, 0, 0, 0)
MainFrame.BackgroundTransparency = 1

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 14)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Parent = MainFrame
UIStroke.Color = Color3.fromRGB(60, 60, 80)
UIStroke.Thickness = 1.5

-- 
local Title = Instance.new("TextLabel")
Title.Name = "Title"
Title.Parent = MainFrame
Title.BackgroundTransparency = 1
Title.Position = UDim2.new(0, 0, 0, 15)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Font = Enum.Font.GothamBold
Title.Text = "VI HIEU KEY"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 18

-- 
local TextBox = Instance.new("TextBox")
TextBox.Name = "TextBox"
TextBox.Parent = MainFrame
TextBox.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
TextBox.Position = UDim2.new(0.1, 0, 0.32, 0)
TextBox.Size = UDim2.new(0.8, 0, 0, 42)
TextBox.Font = Enum.Font.Gotham
TextBox.PlaceholderText = "Nhập mã key tại đây..."
TextBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
TextBox.Text = ""
TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBox.TextSize = 14
TextBox.BorderSizePixel = 0

local BoxCorner = Instance.new("UICorner")
BoxCorner.CornerRadius = UDim.new(0, 8)
BoxCorner.Parent = TextBox

-- 
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Name = "StatusLabel"
StatusLabel.Parent = MainFrame
StatusLabel.BackgroundTransparency = 1
StatusLabel.Position = UDim2.new(0.1, 0, 0.58, 0)
StatusLabel.Size = UDim2.new(0.8, 0, 0, 20)
StatusLabel.Font = Enum.Font.Gotham
StatusLabel.Text = ""
StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
StatusLabel.TextSize = 13

-- 
local CopyButton = Instance.new("TextButton")
CopyButton.Name = "CopyButton"
CopyButton.Parent = MainFrame
CopyButton.BackgroundColor3 = Color3.fromRGB(0, 110, 255)
CopyButton.Position = UDim2.new(0.1, 0, 0.72, 0)
CopyButton.Size = UDim2.new(0.38, 0, 0, 40)
CopyButton.Font = Enum.Font.GothamSemibold
CopyButton.Text = "Get Key"
CopyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CopyButton.TextSize = 14
CopyButton.BorderSizePixel = 0

local CopyCorner = Instance.new("UICorner")
CopyCorner.CornerRadius = UDim.new(0, 8)
CopyCorner.Parent = CopyButton

--
local CheckButton = Instance.new("TextButton")
CheckButton.Name = "CheckButton"
CheckButton.Parent = MainFrame
CheckButton.BackgroundColor3 = Color3.fromRGB(0, 200, 90)
CheckButton.Position = UDim2.new(0.52, 0, 0.72, 0)
CheckButton.Size = UDim2.new(0.38, 0, 0, 40)
CheckButton.Font = Enum.Font.GothamBold
CheckButton.Text = "Xác Nhận"
CheckButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CheckButton.TextSize = 14
CheckButton.BorderSizePixel = 0

local CheckCorner = Instance.new("UICorner")
CheckCorner.CornerRadius = UDim.new(0, 8)
CheckCorner.Parent = CheckButton

-- 
TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 320, 0, 230),
    BackgroundTransparency = 0
}):Play()

-- 
CopyButton.MouseButton1Click:Connect(function()
    local link = "https://sites.google.com/view/vihieu/trang-chủ#h.m2ax7dg2dmlt"
    if setclipboard then
        setclipboard(link)
        CopyButton.Text = "Đã copy!"
        task.wait(2)
        CopyButton.Text = "Get Key"
    else
        CopyButton.Text = "Không hỗ trợ!"
        task.wait(2)
        CopyButton.Text = "Get Key"
    end
end)

-- 
local CORRECT_KEY = "vi_hieu_7f8c9b2a4e1d3f6a8b5c9e2f1a4d7b3c " 

-- 
CheckButton.MouseButton1Click:Connect(function()
    if TextBox.Text == CORRECT_KEY then
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        StatusLabel.Text = "Key chính xác! Đang tải..."
        
        -- 
        task.wait(0.5)
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        })
        closeTween:Play()
        closeTween.Completed:Wait()
        
        ScreenGui:Destroy()
        
        -- Chạy script chính của bạn
        local success, err = pcall(function()
           loadstring(game:HttpGet("https://raw.githubusercontent.com/hieuhieu989/hieuhieu/refs/heads/main/vihieu.2"))()
        end)
        
        if not success then
            warn("Lỗi khi load script: " .. tostring(err))
        end
    else
        -- Hiển thị thông báo sai key trực tiếp trên UI
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "Sai key! Vui lòng nhập lại."
        TextBox.Text = ""
    end
end)
